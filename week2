import numpy as np
def sigmoid(z):
    return 1/(1+np.exp(-z))
def compute_cost(y,y_pred):
    m=len(y)
    return np.sum((y-y_pred)**2)/(2*m)
m=int(input("enter number of training samples:"))
n=int(input("enter number of input features:"))
X=[]
Y=[]
print("enter training data")
for i in range(m):
    print(f"\nSample {i+1}")
    row=[]
    for j in range(n):
        value=float(input(f"enter X{j+1}:"))
        row.append(value)
    target = int(input("enter target output(0/1):"))
    X.append(row)
    Y.append(target)
X=np.array(X)
Y=np.array(Y)
print("\nenter initial weights")
weights=[]
for i in range(n):
    w=float(input(f"weight W{i+1}:"))
    weights.append(w)
weights=np.array(weights)
bias=float(input("enter initial bias:"))
learning_rate=float(input("enter learning rate:"))
tolerance=float(input("Enter saturation tolerance(eg 0.000001):"))
max_iter=10000
prev_cost=float('inf')
iteration=0
while True:
    iteration+=1
    z=np.dot(X,weights)+bias
    y_pred=sigmoid(z)
    cost=compute_cost(Y,y_pred)
    error=(y_pred-Y)*y_pred*(1-y_pred)
    dw=(1/m)*np.dot(X.T,error)
    db=(1/m)*np.sum(error)
    weights=weights-learning_rate*dw
    bias=bias-learning_rate*db
    print(iteration,cost,bias,weights)
    if abs(prev_cost-cost)<tolerance:
        break
    prev_cost=cost
    if iteration>=max_iter:
        break
print("training completed")
print("weights=", weights)
print("bias=", bias)
print("cost=", cost)
predicted=(y_pred>=0.5).astype(int)
print(predicted)
