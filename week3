import numpy as np
def tanh(x):
    return np.tanh(x)
def tanh_derivative(x):
    return 1-np.tanh(x)**2
def compute_cost(y,y_pred):
    m=len(y)
    epsilon=1e-10
    cost=-(1/m)*np.sum(
        y*np.log(y_pred+epsilon)+
        (1-y)*np.log(1-y_pred+epsilon)
    )
    return cost

